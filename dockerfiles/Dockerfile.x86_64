FROM ghcr.io/cross-rs/x86_64-unknown-linux-gnu:edge@sha256:bd64b44f22afa7ec8ba332f4fd9943a4b43252d9f1174a10214d960423dd7732

RUN apt-get update && \
  apt-get install --assume-yes \
  glibc-source \
  build-essential 

RUN DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y software-properties-common && \
  rm -rf /var/lib/apt/lists/*

RUN add-apt-repository ppa:pipewire-debian/pipewire-upstream -y

RUN apt-get install --assume-yes \
  libpipewire-0.3-dev

